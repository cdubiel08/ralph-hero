# Git worktrees (created by scripts/create-worktree.sh)
worktrees/

# Knowledge DB (lives at ~/.ralph-hero/knowledge.db)
knowledge.db

# Obsidian
thoughts/.obsidian/
thoughts/Untitled*.canvas

# Generated knowledge index (rebuilt by ralph-knowledge:setup)
thoughts/_*.md
thoughts/_issues/

# Local-only files (secrets, tokens, config)
*.local.md
*.local.json
.env
.env.*

# Playwright CLI session data (ephemeral screenshots/snapshots)
.playwright-cli/

# Baseline screenshots for semantic diff (local-only, per-developer state)
thoughts/local/baselines/

# Pilot notes for in-loop semantic visual diff (per-operator session notes)
thoughts/local/pilots/

# Vitest coverage output (rebuilt by `npm test` / `pnpm test`)
plugin/*/coverage/
plugin/*/*/coverage/

# Top-level MCP server build/test artifacts (source relocated here in GH-1436;
# `dist/` is never committed — see CLAUDE.md "What This Is").
mcp-server/dist/
mcp-server/coverage/
mcp-server/node_modules/

# scripts/ subpackages (routing, model-tiers, ...) — CI runs `npm ci` from
# their own committed package-lock.json; node_modules is never committed.
scripts/*/node_modules/
