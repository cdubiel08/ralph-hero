{
  "name": "ralph-hero-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "board": "tsx ralph/scripts/board.ts",
    "test:board": "vitest run ralph/scripts/",
    "test:naming": "bash plugin/ralph-herdr/tests/naming.test.sh",
    "test:spawn": "bash plugin/ralph-herdr/tests/spawn.test.sh",
    "test:watcher": "bash plugin/ralph-herdr/tests/watcher.test.sh",
    "test:fleet": "bash plugin/ralph-herdr/tests/fleet.test.sh",
    "test:lineage": "bash plugin/ralph-herdr/tests/doctor-lineage.test.sh",
    "contracts:emit": "tsx ralph/scripts/board.ts contract emit",
    "contracts:check": "tmp=$(mktemp -d) && tsx ralph/scripts/board.ts contract emit --out \"$tmp\" >/dev/null && diff -r ralph/contracts/generated \"$tmp\""
  },
  "dependencies": {
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
