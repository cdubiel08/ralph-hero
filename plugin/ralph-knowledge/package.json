{
  "name": "ralph-hero-knowledge-index",
  "version": "0.1.53",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ralph-hero-knowledge-index": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cdubiel08/ralph-hero.git",
    "directory": "plugin/ralph-knowledge"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "reindex": "NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" node dist/reindex.js",
    "test": "vitest run --coverage",
    "bench:heap": "tsx benchmark/reindex-heap-bench.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "verify:tiers": "node dist/scripts/verify-tiers.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-metrics": "^2.4.0",
    "graphology-operators": "^1.6.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-simple-path": "^0.2.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "ignore": "^7.0.5",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
