{
  "name": "demo-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "Remotion scaffold for ralph demo videos",
  "scripts": {
    "dev": "remotion studio",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p ../skills/demo/references/examples/tsconfig.json",
    "measure": "node scripts/measure-clip.mjs",
    "test:measure": "bash scripts/measure-clip.test.sh",
    "render": "bash scripts/render.sh",
    "test:render": "bash scripts/render.test.sh"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.509",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "^4.0.509"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ws@<8.20.1": "^8.20.1"
    }
  }
}
