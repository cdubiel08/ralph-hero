{
  "$id": "ralph:contracts/ralph.escalation",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "ralph.escalation"
    },
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "agent": {
      "type": "string",
      "maxLength": 32
    },
    "issue": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "recommended": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "resume": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "herdr_prompt",
            "board_comment"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "contract_version",
    "issue",
    "title",
    "body",
    "options",
    "resume"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
