#!/usr/bin/env bash
# rh — Ralph Hero's portable command router.

RH_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export RH_SCRIPT_DIR

# shellcheck source=rh-lib/resolve.sh
source "$RH_SCRIPT_DIR/rh-lib/resolve.sh"
# shellcheck source=rh-lib/render.sh
source "$RH_SCRIPT_DIR/rh-lib/render.sh"

usage_error() {
  echo "rh: $*" >&2
  echo "Run 'rh help' for usage." >&2
  return 64
}

RH_COLOR_MODE=auto
while [ "$#" -gt 0 ]; do
  case "$1" in
    --color=auto|--color=always|--color=never)
      RH_COLOR_MODE="${1#--color=}"
      shift
      ;;
    --help|--version) break ;;
    --*)
      usage_error "unknown global option '$1' (accepts --color=auto|always|never)"
      exit $?
      ;;
    *) break ;;
  esac
done
[ -n "${NO_COLOR:-}" ] && RH_COLOR_MODE=never
export RH_COLOR_MODE

command="${1:-help}"
case "$command" in
  board)
    shift
    board=$(rh_resolve_board) || exit $?
    exec "$board" "$@"
    ;;
  help|-h|--help)
    [ "$#" -eq 0 ] || shift
    rh_render_help "${1-}"
    ;;
  version|--version)
    printf 'rh %s\n' "$(rh_version)"
    ;;
  "")
    rh_render_help
    ;;
  *)
    usage_error "unknown command '$command'; try 'rh dispatch' or 'rh help'"
    exit $?
    ;;
esac
