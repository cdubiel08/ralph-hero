#!/usr/bin/env bash
# board — runner shim for board.ts. Prefers bun, then repo-local tsx, then npx tsx.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TS="$DIR/board.ts"
ROOT="$(cd "$DIR/../.." && pwd)"

if command -v bun >/dev/null 2>&1; then
  exec bun "$TS" "$@"
elif [ -x "$ROOT/node_modules/.bin/tsx" ]; then
  exec "$ROOT/node_modules/.bin/tsx" "$TS" "$@"
else
  echo "board: no runtime found — install bun, or run 'npm install' at $ROOT for the pinned tsx" >&2
  exit 69
fi
