{
  "version": 1,
  "attestation": {
    "required": true
  },
  "external_review": {
    "required": true,
    "bot": "chatgpt-codex-connector[bot]",
    "trigger": "@codex review for P0 issues only",
    "head_marker": "ralph-review-head"
  },
  "exempt_authors": [
    "dependabot[bot]",
    "app/dependabot",
    "github-actions[bot]",
    "app/github-actions"
  ],
  "apply": {
    "enabled": true,
    "label": "ralph:apply",
    "infraPaths": [
      ".github/**",
      "ralph/scripts/install-loop.sh"
    ]
  },
  "verify": {
    "runs": [
      "npx vitest run ralph/scripts/",
      "npx tsc --noEmit"
    ],
    "pathRuns": {
      "plugin/ralph-herdr/cockpit/**": [
        "bash -c 'cd plugin/ralph-herdr/cockpit && test -z \"$(gofmt -l .)\" && go vet ./... && go test ./...'"
      ],
      "plugin/ralph-knowledge/**": [
        "bash -c 'cd plugin/ralph-knowledge && npm run build && npm test'"
      ]
    }
  }
}
