{
  "version": 1,
  "attestation": {
    "required": true
  },
  "external_review": {
    "required": true,
    "bot": "chatgpt-codex-connector[bot]",
    "trigger": "@codex review",
    "head_marker": "ralph-review-head",
    "clean_comment_marker": "Codex Review: Didn't find any major issues."
  },
  "exempt_authors": [
    "dependabot[bot]",
    "app/dependabot",
    "github-actions[bot]",
    "app/github-actions"
  ],
  "apply": {
    "enabled": true,
    "label": "ralph:apply",
    "infraPaths": [
      ".github/**",
      "ralph/scripts/install-loop.sh"
    ]
  }
}
