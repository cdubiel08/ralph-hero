{
  "version": 1,
  "attestation": {
    "required": true
  },
  "external_review": {
    "required": true,
    "bot": "chatgpt-codex-connector[bot]",
    "trigger": "@codex review"
  },
  "exempt_authors": [
    "dependabot[bot]",
    "app/dependabot",
    "github-actions[bot]",
    "app/github-actions"
  ],
  "apply": {
    "enabled": true,
    "label": "ralph:apply",
    "infraPaths": [
      ".github/**",
      "ralph/scripts/install-loop.sh"
    ]
  }
}
